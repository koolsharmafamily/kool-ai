# Copy this file to .env.local for local `vercel dev`, or set these as
# Environment Variables in your Vercel project settings for production.
# Never commit real keys or prefix them with VITE_ (that would ship them
# to the browser) — they're read server-side only, inside api/chat.js.

# Required to use the Gemini model options (gemini-flash-latest,
# gemini-flash-lite-latest). Get one at https://aistudio.google.com/apikey —
# free tier, no payment method required.
GOOGLE_API_KEY=

# Optional — only needed if you add Claude models back to src/lib/models.js.
# The backend already supports them (see api/chat.js). Get one at
# https://console.anthropic.com/ — pay-as-you-go.
ANTHROPIC_API_KEY=

# Optional — only needed if you add GPT models back to src/lib/models.js.
# The backend already supports them (see api/chat.js). Get one at
# https://platform.openai.com/api-keys — pay-as-you-go.
OPENAI_API_KEY=
