# Copy this file to .env.local for local `vercel dev`, or set these as
# Environment Variables in your Vercel project settings for production.
# Never commit real keys or prefix them with VITE_ (that would ship them
# to the browser) — they're read server-side only, inside api/chat.js.

# Required to use the Claude model options (claude-sonnet-5, claude-opus-5,
# claude-haiku-4-5-20251001). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required to use the GPT model options (gpt-4o, gpt-4-turbo, gpt-3.5-turbo).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
